{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutibarasculpturepark",
  "compatibility_date": "2025-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
